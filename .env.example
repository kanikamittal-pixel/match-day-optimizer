# All variables are SERVER-ONLY. None are prefixed NEXT_PUBLIC_, so none reach the browser.
# Copy to .env.local for local dev; set the same names in Vercel > Project > Settings > Environment Variables.

# Supabase (Project Settings > API). The anon key is used with Aryan's signed-in session + RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google AI Studio key for Gemini Flash (the only AI used anywhere in the app)
GEMINI_API_KEY=
# Optional: override the model id (default gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# CricketData.org (cricapi.com) key. Sent as ?apikey= so calls are made server-side only.
CRICKETDATA_API_KEY=
# Optional: daily hit budget kept below the free tier's 100 (default 95)
CRICKETDATA_DAILY_LIMIT=95

# Optional reviewer access: shows a "Continue as demo" button that signs in server-side.
# Create this user in Supabase > Authentication > Users. Unset DEMO_MODE to switch it off.
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=

# Reviewer mode: no login. Needs 0002_open_access.sql. Set false to require login.
OPEN_ACCESS=false

# RapidAPI (Cricbuzz) - second cricket data source
RAPIDAPI_KEY=
RAPIDAPI_CRICKET_HOST=free-cricbuzz-cricket-api.p.rapidapi.com
# Free plan = 100 requests/MONTH; keep a safety margin
RAPIDAPI_MONTHLY_LIMIT=90

# Protects /api/cron/cricsheet (Vercel Cron sends it automatically)
CRON_SECRET=
