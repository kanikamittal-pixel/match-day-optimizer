# All variables are SERVER-ONLY. None are prefixed NEXT_PUBLIC_, so none reach the browser.
# Copy to .env.local for local dev; set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real values (.env* is gitignored).

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI: Gemini models, called through OpenRouter (Google models only, served by Google's own providers).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
# Fallback if OPENROUTER_API_KEY is not set: a Google AI Studio key used directly
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# CricketData.org: fixtures, toss, squads, scorecards. Sent as ?apikey=
CRICKETDATA_API_KEY=
# Self-imposed daily budget, kept below the free tier's 100 (default 95; 15 are reserved for scorecards)
CRICKETDATA_DAILY_LIMIT=95

# RapidAPI (Free Cricbuzz Cricket API): upcoming fixtures only
RAPIDAPI_KEY=
RAPIDAPI_CRICKET_HOST=
RAPIDAPI_MONTHLY_LIMIT=90

# Protects /api/cron/cricsheet (Vercel Cron sends it automatically)
CRON_SECRET=

# Access: true = no login (needs supabase/migrations/0002_open_access.sql). false = Aryan must sign in.
OPEN_ACCESS=true
# Only when OPEN_ACCESS=false: optional one-click "Continue as demo" user (create it in Supabase > Authentication)
DEMO_MODE=false
DEMO_EMAIL=
DEMO_PASSWORD=
